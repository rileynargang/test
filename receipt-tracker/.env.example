# Google OAuth Client ID
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select an existing one)
# 3. Enable the Google Drive API
# 4. Go to APIs & Services > Credentials > Create Credentials > OAuth 2.0 Client ID
# 5. Select application type: iOS
# 6. Set the Bundle ID to: com.receipttracker.app
# 7. Copy the Client ID and paste it below
# 8. Rename this file to .env

EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
